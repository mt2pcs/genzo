# ---- サーバ ----
PORT=8080
# 任意: Basic認証（"user:password"）。IAP等で保護する場合は未設定でよい
APP_BASIC_AUTH=

# ---- 保存先（GAS版の Drive フォルダに相当）----
# GCS バケット名を指定すると Cloud Storage に保存。未指定なら STORAGE=local で ./data に保存（ローカル開発用）
GCS_BUCKET=
GCS_PREFIX=genzo/
STORAGE=gcs
DATA_DIR=./data

# ---- LLM プロバイダ: vertex（既定） | openai ----
LLM_PROVIDER=vertex

# ---- Vertex AI（Gemini）----
# 未指定なら ADC（Cloud Run のサービスアカウント / gcloud auth application-default login）から取得
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-pro
# 画像生成: gemini-2.5-flash-image（参照画像つき編集に対応） または imagen-4.0-generate-001 等（imagen* は :predict API・テキストからのみ）
VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
# Imagen を使う場合のリージョン（Imagen は global 未対応）
VERTEX_IMAGE_LOCATION=us-central1

# ---- OpenAI 互換（LLM_PROVIDER=openai のとき。GAS 版の設定と同じ）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
